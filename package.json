    "next": "^15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "pg": "^8.23.0",
