# Copy to .env.local and fill in values from the Supabase dashboard.
# Do not commit real credentials.

# Next.js public vars (used by this app — equivalent to VITE_SUPABASE_* in Vite apps)
# Project: sap-job-finder (ref: jhoaaijrwigvuxhtoadx)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Optional alias names if you prefer Vite-style naming locally (not read by Next.js):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Optional: used when building auth redirect URLs outside the browser.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Employer Portal session policy (application-level; defaults shown).
# NEXT_PUBLIC_EMPLOYER_INACTIVITY_TIMEOUT_MS=1800000
# NEXT_PUBLIC_EMPLOYER_ABSOLUTE_SESSION_MS=28800000
# NEXT_PUBLIC_EMPLOYER_INACTIVITY_WARNING_LEAD_MS=300000
# NEXT_PUBLIC_EMPLOYER_ACTIVITY_THROTTLE_MS=15000
# NEXT_PUBLIC_EMPLOYER_SESSION_TICK_MS=30000

# Google Analytics (gtag.js) measurement ID — set to enable tracking on all pages.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RNVFEQ1F9H

# Employer Bulk Job Template URL (optional Google Drive or CDN hosted .xlsx template)
# NEXT_PUBLIC_BULK_JOB_TEMPLATE_URL=https://docs.google.com/spreadsheets/d/11MgsjOYNwqX_QNsHhK4zPgMdWE_ycs0L/edit?usp=sharing

# NEVER put SUPABASE_SERVICE_ROLE_KEY or DB password in NEXT_PUBLIC_* vars.
# The browser must only use the public publishable/anon key.

# Server-only (local scripts such as scripts/confirm-all-emails.mjs):
# SUPABASE_DB_PASSWORD=your_db_password
# DATABASE_URL=postgresql://postgres:...@db.your-project-ref.supabase.co:5432/postgres

# Server-only Contact Us & Transactional Email configuration (Sprint 8F / 8G):
# SUPPORT_EMAIL=support@sapjobsfinder.com
# EMAIL_PROVIDER=resend # 'resend' or 'console' (default: console)
# RESEND_API_KEY=re_your_resend_api_key_here
# EMAIL_FROM_ADDRESS=SAP Jobs Finder <notifications@sapjobsfinder.com>

# =============================================================================
# Supabase Dashboard configuration (manual)
# =============================================================================
#
# Authentication → URL Configuration:
# - Site URL (local): http://localhost:3000
# - Site URL (production): https://your-production-domain
# - Redirect URLs must include:
#     http://localhost:3000/auth/callback
#     https://your-production-domain/auth/callback
#
# Authentication → Providers → Email:
# - Enable Email provider
# - Confirm email = ON for real verification (Sprint 1 employer verify-email flow)
# - For local smoke tests without inbox: Confirm email = OFF temporarily
#
# Employer auth routes (Sprint 1):
#   /employer/register → Supabase signUp → email confirmation → /employer/login
#   /employer/forgot-password → reset email → /auth/callback?next=/employer/reset-password
#
# Confirm existing users (dev helper):
#   npm run auth:confirm-emails
